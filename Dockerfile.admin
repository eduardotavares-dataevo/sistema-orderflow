# Imagem oficial Python enxuta e estável
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

COPY . .

# Define diretório de execução dentro de admin_panel
WORKDIR /app/admin_panel

EXPOSE 5005

# Executa o painel administrativo com 2 workers Gunicorn
CMD ["gunicorn", "-w", "2", "-b", "0.0.0.0:5005", "--timeout", "120", "app:app"]
