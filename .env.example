# Configurações do Tenant / Empresa
TENANT_ID=empresa_demo
TENANT_NAME=Empresa Demonstracao LTDA
MAX_LICENSES=10

# Chaves de sessão: gere valores aleatórios longos para produção.
SECRET_KEY=
ADMIN_SECRET_KEY=

# Integração Sankhya OM (Servidor do Cliente)
SANKHYA_BASE_URL=https://seu-servidor-sankhya.com.br:8035
SANKHYA_APPKEY=seu_appkey_aqui
SANKHYA_USERNAME=usuario_api
SANKHYA_PASSWORD=

# Configurações do Painel Admin Central (opcional para checagem remota de licenças)
ADMIN_PANEL_URL=http://localhost:5005
ADMIN_API_TOKEN=seu_admin_token_aqui

# Primeiro acesso ao painel administrativo. Defina antes da primeira inicialização.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=

# Sincronizador VPS (opcional para sync_watcher.py)
VPS_HOST=127.0.0.1
VPS_PORT=22
VPS_USER=root
REMOTE_DIR=/opt/orderflow/
